# CORE-AGENT-06 (workspace convention): UTF-8, LF, trimmed, final newline.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,rs,toml}]
indent_size = 4

[Makefile]
indent_style = tab

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

# Swift and C++ in native/ follow their own house style (4 spaces).
[*.{swift,cpp,h,hpp}]
indent_size = 4
